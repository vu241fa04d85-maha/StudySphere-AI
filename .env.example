# AI Study Assistant (AI-SA) — Environment Variables

# Supabase Public Keys (Used by Web Frontend & Mobile Clients)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Supabase Server-Side Secret Key (Edge Functions & Secure Admin Provisioning ONLY)
# NEVER commit or expose this key in client-side bundles!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# AI Model Provider (Gemini API / Vertex AI)
# Used server-side inside Supabase Edge Functions or AI Studio
GEMINI_API_KEY=YOUR_SECURE_GEMINI_API_KEY
AI_MODEL_NAME=gemini-1.5-pro-latest

# Backup & Disaster Recovery Configurations
BACKUP_STORAGE_BUCKET=ai-study-assistant-backups
BACKUP_ENCRYPTION_PASSPHRASE=generate_a_secure_256bit_passphrase
BACKUP_NOTIFICATION_WEBHOOK=https://api.opsgenie.com/v1/json/webhook

# Security & Multi-Factor Authentication
MFA_ISSUER_NAME="AI Study Assistant Academic Portal"
SESSION_TIMEOUT_MINUTES=60
